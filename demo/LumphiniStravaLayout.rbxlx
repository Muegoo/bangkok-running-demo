4838431936275</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><bool name="Anchored">true</bool><bool name="Neutral">true</bool><float name="Duration">0</float><float name="Transparency">1</float><bool name="CanCollide">false</bool></Properties></Item><Item class="Camera" referent="LUMRUN7234"><Properties><string name="Name">Camera</string><CoordinateFrame name="CFrame"><X>22</X><Y>2350</Y><Z>360</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>0.16779934804836205</R11><R12>0.985821169784127</R12><R20>0</R20><R21>-0.985821169784127</R21><R22>0.16779934804836205</R22></CoordinateFrame><float name="FieldOfView">50</float></Properties></Item></Item><Item class="ReplicatedStorage" referent="LUMRUN7238"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="LUMRUN7236"><Properties><string name="Name">ParkConfig</string><ProtectedString name="Source">return {studsPerMeter=2,runSpeedStuds=20,loopMeters=2591.87,innerLoopMeters=1084.22,parks={lumphini={name=&quot;สวนลุมพินี&quot;,spawn={-478.92959326418077,7,153.54838431936275},forward={0.5347025731206692,0,0.845040329391524}}}}</ProtectedString></Properties></Item><Item class="RemoteEvent" referent="LUMRUN7237"><Properties><string name="Name">SelectPark</string></Properties></Item></Item><Item class="ServerScriptService" referent="LUMRUN7240"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="LUMRUN7239"><Properties><string name="Name">RunServer</string><ProtectedString name="Source">-- Demo settings are deliberately separate from real survey measurements.
local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local config = require(ReplicatedStorage:WaitForChild(&quot;ParkConfig&quot;))
local switch = ReplicatedStorage:WaitForChild(&quot;SelectPark&quot;)
local states = {}

local function enterPark(player, parkId)
    local park = config.parks[parkId]
    local state = states[player]
    if not park or not state then return end
    state.park = parkId
    state.last = nil
    state.distance = 0
    state.elapsed = 0
    player:SetAttribute(&quot;ParkName&quot;, park.name)
    player:SetAttribute(&quot;DistanceMeters&quot;, 0)
    player:SetAttribute(&quot;RunningSeconds&quot;, 0)
    local character = player.Character
    if character and character:FindFirstChild(&quot;HumanoidRootPart&quot;) then
        local position = Vector3.new(table.unpack(park.spawn))
        local forward = Vector3.new(table.unpack(park.forward or {0, 0, -1}))
        character:PivotTo(CFrame.lookAt(position, position + forward))
        local root = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function setup(player)
    states[player] = {park = &quot;lumphini&quot;, distance = 0, elapsed = 0, cooldown = 0, publish = 0}
    local function characterAdded(character)
        local humanoid = character:WaitForChild(&quot;Humanoid&quot;, 15)
        local root = character:WaitForChild(&quot;HumanoidRootPart&quot;, 15)
        -- Let Roblox finish placing the character before selecting our route spawn.
        task.wait(0.15)
        if humanoid and root and states[player] and player.Character == character then
            humanoid.WalkSpeed = config.runSpeedStuds
            enterPark(player, states[player].park)
        end
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character then task.spawn(characterAdded, player.Character) end
    player:SetAttribute(&quot;ParkName&quot;, config.parks.lumphini.name)
end
Players.PlayerAdded:Connect(setup)
for _, player in Players:GetPlayers() do setup(player) end
Players.PlayerRemoving:Connect(function(player) states[player] = nil end)
switch.OnServerEvent:Connect(function(player, parkId)
    local state = states[player]
    if type(parkId) ~= &quot;string&quot; or not config.parks[parkId] or not state then return end
    if os.clock() - state.cooldown &lt; 1 then return end
    state.cooldown = os.clock()
    enterPark(player, parkId)
end)

RunService.Heartbeat:Connect(function(dt)
    for player, state in states do
        local character = player.Character
        local root = character and character:FindFirstChild(&quot;HumanoidRootPart&quot;)
        local humanoid = character and character:FindFirstChild(&quot;Humanoid&quot;)
        if root and humanoid and humanoid.Health &gt; 0 then
            local current = Vector2.new(root.Position.X, root.Position.Z)
            if state.last and humanoid.FloorMaterial ~= Enum.Material.Air then
                local moved = (current-state.last).Magnitude
                -- Exclude teleports and spikes; this is a demo movement counter, not a race record.
                if moved &gt; 0.005 and moved &lt;= config.runSpeedStuds*dt*2 + 1 then
                    state.distance += moved/config.studsPerMeter
                    state.elapsed += dt
                end
            end
            state.last = current
            state.publish += dt
            if state.publish &gt;= 0.25 then
                state.publish = 0
                player:SetAttribute(&quot;DistanceMeters&quot;, math.floor(state.distance))
                player:SetAttribute(&quot;RunningSeconds&quot;, math.floor(state.elapsed))
            end
        else
            state.last = nil
        end
    end
end)
</ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="LUMRUN7246"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="LUMRUN7245"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="LUMRUN7241"><Properties><string name="Name">RunCamera</string><ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Input = game:GetService(&quot;UserInputService&quot;)
local player = Players.LocalPlayer
local config = require(game.ReplicatedStorage:WaitForChild(&quot;ParkConfig&quot;))
local yaw, pitch, dragging = 0, -0.035, false
local touchLook = nil
local firstPerson = false
local currentCharacter, bodyParts = nil, {}
local parkLights = {}
local function align()
    -- Reserve local-light rendering for the park the player is actually visiting.
    for id, park in config.parks do
        if not parkLights[id] then
            local model = workspace:FindFirstChild(id)
            local scene = model and model:FindFirstChild(&quot;RunningExperience&quot;)
            if scene then
                parkLights[id] = {}
                for _, light in scene:GetDescendants() do
                    if light:IsA(&quot;SpotLight&quot;) then table.insert(parkLights[id], light) end
                end
            end
        end
        for _, light in parkLights[id] or {} do
            light.Enabled = park.name == player:GetAttribute(&quot;ParkName&quot;)
        end
    end
    for _, park in config.parks do
        if park.name == player:GetAttribute(&quot;ParkName&quot;) and park.forward then
            yaw = math.atan2(-park.forward[1], -park.forward[3])
            pitch = -0.035
        end
    end
end
local function visibility()
    firstPerson = player:GetAttribute(&quot;FirstPersonView&quot;) == true
    for _, part in bodyParts do
        if part.Parent then part.LocalTransparencyModifier = if firstPerson then 1 else 0 end
    end
end
local function characterAdded(character)
    currentCharacter = character
    bodyParts = {}
    for _, part in character:GetDescendants() do
        if part:IsA(&quot;BasePart&quot;) then table.insert(bodyParts, part) end
    end
    character.DescendantAdded:Connect(function(part)
        if part:IsA(&quot;BasePart&quot;) then table.insert(bodyParts, part); visibility() end
    end)
    align()
    visibility()
end
player.CharacterAdded:Connect(characterAdded)
if player.Character then characterAdded(player.Character) end
player:GetAttributeChangedSignal(&quot;ParkName&quot;):Connect(align)
player:GetAttributeChangedSignal(&quot;FirstPersonView&quot;):Connect(visibility)
Input.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.V then
        player:SetAttribute(&quot;FirstPersonView&quot;, not firstPerson)
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        dragging = true
        Input.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    elseif input.UserInputType == Enum.UserInputType.Touch then
        local camera = workspace.CurrentCamera
        if camera and input.Position.X &gt; camera.ViewportSize.X * 0.55 then touchLook = input end
    end
end)
Input.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        dragging = false
        Input.MouseBehavior = Enum.MouseBehavior.Default
    end
    if input == touchLook then touchLook = nil end
end)
Input.WindowFocusReleased:Connect(function()
    dragging = false
    touchLook = nil
    Input.MouseBehavior = Enum.MouseBehavior.Default
end)
Input.InputChanged:Connect(function(input)
    if (dragging and input.UserInputType == Enum.UserInputType.MouseMovement) or input == touchLook then
        yaw -= input.Delta.X * 0.0035
        pitch = math.clamp(pitch - input.Delta.Y * 0.0025, -0.45, 0.3)
    end
end)
align()
local ray = RaycastParams.new()
ray.FilterType = Enum.RaycastFilterType.Exclude
RunService:BindToRenderStep(&quot;ParkRunningCamera&quot;, Enum.RenderPriority.Camera.Value + 1, function()
    local camera = workspace.CurrentCamera
    local root = currentCharacter and currentCharacter:FindFirstChild(&quot;HumanoidRootPart&quot;)
    local humanoid = currentCharacter and currentCharacter:FindFirstChildOfClass(&quot;Humanoid&quot;)
    if not camera or not root or not humanoid then return end
    local rotation = CFrame.fromOrientation(pitch, yaw, 0)
    local forward = rotation.LookVector
    local eye = root.Position + Vector3.new(0, 1.8, 0)
    local bob = if humanoid.MoveDirection.Magnitude &gt; 0.1 then math.sin(os.clock() * 13) * 0.035 else 0
    local desired = eye + Vector3.new(0, bob, 0)
    if not firstPerson then
        desired += -forward * 6.5 + rotation.RightVector * 1.0 + Vector3.new(0, 1.25, 0)
        ray.FilterDescendantsInstances = {currentCharacter}
        local hit = workspace:Raycast(eye, desired - eye, ray)
        if hit then desired = hit.Position + hit.Normal * 0.35 end
    end
    camera.CameraType = Enum.CameraType.Scriptable
    camera.FieldOfView = 68
    camera.CFrame = CFrame.lookAt(desired, desired + forward * 100)
    camera.Focus = CFrame.new(eye + forward * 12)
    visibility()
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="LUMRUN7242"><Properties><string name="Name">RunHud</string><ProtectedString name="Source">local p = game.Players.LocalPlayer
local config = require(game.ReplicatedStorage:WaitForChild(&quot;ParkConfig&quot;))
pcall(function() game:GetService(&quot;StarterGui&quot;):SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false) end)
local gui = Instance.new(&quot;ScreenGui&quot;)
gui.Name = &quot;LumphiniLoopHUD&quot;
gui.ResetOnSpawn = false
gui.Parent = p:WaitForChild(&quot;PlayerGui&quot;)
local panel = Instance.new(&quot;Frame&quot;, gui)
panel.Size = UDim2.fromOffset(310, 112)
panel.Position = UDim2.fromOffset(18, 14)
panel.BackgroundColor3 = Color3.fromRGB(20, 35, 29)
panel.BackgroundTransparency = .15
Instance.new(&quot;UICorner&quot;, panel).CornerRadius = UDim.new(0, 12)
local function label(text, y, size)
    local t = Instance.new(&quot;TextLabel&quot;, panel)
    t.BackgroundTransparency = 1
    t.Position = UDim2.fromOffset(14, y)
    t.Size = UDim2.new(1, -28, 0, 28)
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Font = Enum.Font.GothamMedium
    t.TextColor3 = Color3.fromRGB(239, 243, 229)
    t.TextSize = size
    t.Text = text
    return t
end
label(&quot;สวนลุมพินี · เส้นทางทดลอง&quot;, 8, 19)
local stats = label(&quot;0 ม.   00:00&quot;, 37, 24)
label(if config.innerLoopMeters then string.format(&quot;วงใหญ่ %.2f กม. · วงใน %.2f กม.&quot;,config.loopMeters/1000,config.innerLoopMeters/1000) else string.format(&quot;วงรอบทดลอง %.2f กม.&quot;, config.loopMeters / 1000), 74, 13)
local view = Instance.new(&quot;TextButton&quot;, gui)
view.Name = &quot;CameraView&quot;
view.AnchorPoint = Vector2.new(1, 0)
view.Position = UDim2.new(1, -18, 0, 14)
view.Size = UDim2.fromOffset(138, 36)
view.BackgroundColor3 = Color3.fromRGB(40, 64, 50)
view.TextColor3 = Color3.fromRGB(239, 243, 229)
view.Font = Enum.Font.GothamMedium
view.TextSize = 14
Instance.new(&quot;UICorner&quot;, view).CornerRadius = UDim.new(0, 10)
view.Activated:Connect(function() p:SetAttribute(&quot;FirstPersonView&quot;,p:GetAttribute(&quot;FirstPersonView&quot;) ~= true) end)
local function update()
    local seconds = p:GetAttribute(&quot;RunningSeconds&quot;) or 0
    stats.Text = string.format(&quot;%d ม.   %02d:%02d&quot;, p:GetAttribute(&quot;DistanceMeters&quot;) or 0, math.floor(seconds/60),seconds%60)
    view.Text = if p:GetAttribute(&quot;FirstPersonView&quot;) then &quot;สายตา · V&quot; else &quot;ตามหลัง · V&quot;
end
for _, attr in {&quot;DistanceMeters&quot;, &quot;RunningSeconds&quot;, &quot;FirstPersonView&quot;} do p:GetAttributeChangedSignal(attr):Connect(update) end
local footer = Instance.new(&quot;TextLabel&quot;,gui)
footer.BackgroundTransparency = 1
footer.Position = UDim2.new(0,18,1,-54)
footer.Size = UDim2.new(1,-36,0,45)
footer.TextXAlignment = Enum.TextXAlignment.Left
footer.TextSize = 12
footer.TextColor3 = Color3.fromRGB(237,240,225)
footer.Text = &quot;WASD วิ่ง · ลากเมาส์ขวาเพื่อมอง · V เปลี่ยนมุมมอง\nMap data © OpenStreetMap contributors · ODbL&quot;
update()
</ProtectedString></Properties></Item><Item class="LocalScript" referent="LUMRUN7243"><Properties><string name="Name">AmbientRunners</string><ProtectedString name="Source">-- Decorative runners animate locally; they have no collision or gameplay authority.
local RunService = game:GetService(&quot;RunService&quot;)
local player = game.Players.LocalPlayer
local routes = {}
local function register(scene)
    if routes[scene] or not scene:FindFirstChild(&quot;Waypoints&quot;) then return end
    local points = scene.Waypoints:GetChildren()
    table.sort(points, function(a,b) return a.Name &lt; b.Name end)
    if #points &lt; 2 then return end
    local distances = {0}
    for i = 2, #points do distances[i] = distances[i-1] + (points[i].Position-points[i-1].Position).Magnitude end
    local runners = {}
    for _, model in scene:GetChildren() do
        if model:IsA(&quot;Model&quot;) and model.Name:match(&quot;^Runner_&quot;) then
            local offsets = {}
            local base = CFrame.new(model.Torso.Position - Vector3.new(0,2.9,0)) * model.Torso.CFrame.Rotation
            for _, part in model:GetChildren() do
                if part:IsA(&quot;BasePart&quot;) then offsets[part] = base:ToObjectSpace(part.CFrame) end
            end
            table.insert(runners, {model=model, offsets=offsets, phase=#runners*110+60})
        end
    end
    routes[scene] = {points=points, distances=distances, total=distances[#distances], runners=runners}
end
for _, park in {&quot;lumphini&quot;} do
    register(workspace:WaitForChild(park):WaitForChild(&quot;RunningExperience&quot;))
end
local elapsed, accumulator = 0, 0
RunService.Heartbeat:Connect(function(dt)
    elapsed += dt
    accumulator += dt
    if accumulator &lt; 1/30 then return end
    accumulator = 0
    local root = player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
    if not root then return end
    for _, route in routes do
        for _, runner in route.runners do
            local progress = (elapsed*8 + runner.phase) % (route.total*2)
            local reversed = progress &gt; route.total
            local d = if reversed then route.total*2-progress else progress
            local index = 2
            while index &lt; #route.points and route.distances[index] &lt; d do index += 1 end
            local a, b = route.points[index-1].Position, route.points[index].Position
            local t = (d-route.distances[index-1]) / math.max(0.001, route.distances[index]-route.distances[index-1])
            local direction = (b-a).Unit * (if reversed then -1 else 1)
            local side = Vector3.new(-direction.Z,0,direction.X)*1.4
            local pos = a:Lerp(b,t) + side
            if (pos-root.Position).Magnitude &lt; 320 then
                local pivot = CFrame.lookAt(pos, pos+direction)
                local swing = math.sin(elapsed*10 + runner.phase)*0.65
                for part, offset in runner.offsets do
                    local factor = if part.Name == &quot;LeftLeg&quot; or part.Name == &quot;RightArm&quot; then 1 elseif part.Name == &quot;RightLeg&quot; or part.Name == &quot;LeftArm&quot; then -1 else 0
                    part.CFrame = pivot * offset * CFrame.Angles(swing*factor,0,0)
                end
            end
        end
    end
end)
</ProtectedString></Properties></Item><Item class="LocalScript" referent="LUMRUN7244"><Properties><string name="Name">LoopEnvironment</string><ProtectedString name="Source">-- Keep only nearby lamps enabled to preserve rendering detail along the full loop.
local player = game.Players.LocalPlayer
local scene = workspace:WaitForChild(&quot;lumphini&quot;):WaitForChild(&quot;RunningExperience&quot;)
local lights = {}
for _, v in scene:GetDescendants() do if v:IsA(&quot;SpotLight&quot;) then table.insert(lights,v) end end
while true do
    local root = player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
    if root then
        for _, light in lights do light.Enabled = (light.Parent.Position-root.Position).Magnitude &lt; 180 end
    end
    task.wait(.5)
end
</ProtectedString></Properties></Item></Item></Item><Item class="Lighting" referent="LUMRUN7249"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><token name="LightingStyle">0</token><bool name="PrioritizeLightingQuality">true</bool><bool name="GlobalShadows">true</bool><float name="ClockTime">11</float><float name="Brightness">1.4</float><float name="ExposureCompensation">0.35</float><Color3 name="Ambient"><R>0.30196078431372547</R><G>0.3333333333333333</G><B>0.3568627450980392</B></Color3><Color3 name="OutdoorAmbient"><R>0.33725490196078434</R><G>0.3764705882352941</G><B>0.403921568627451</B></Color3></Properties><Item class="BloomEffect" referent="LUMRUN7247"><Properties><string name="Name">ParkBloom</string><float name="Intensity">0.15</float><float name="Size">18</float><float name="Threshold">1.6</float></Properties></Item><Item class="Atmosphere" referent="LUMRUN7248"><Properties><string name="Name">ParkAtmosphere</string><float name="Density">0.18</float><Color3 name="Color"><R>0.6862745098039216</R><G>0.7450980392156863</G><B>0.8235294117647058</B></Color3></Properties></Item></Item></roblox>